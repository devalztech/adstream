# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Render/Koyeb managed Postgres connection string, e.g.:
# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adstream
DATABASE_SSL=false
DB_POOL_MAX=10
# Only needed if your Postgres provider issues a real CA cert and
# enforces verification (e.g. Aiven). Paste the full contents of the
# provider's downloaded ca.pem here (Render's own Postgres doesn't need
# this — leave unset and it falls back to permissive SSL for that case).
DATABASE_CA_CERT=
# Used only by `npm test` for integration tests — point this at a
# separate database so tests never touch dev data. See tests/README.md.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/adstream_test

# --- Auth ---
# Generate strong random secrets, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of allowed origins, or leave unset for '*' (dev only)
CORS_ORIGIN=http://localhost:3000

# --- App ---
FRONTEND_URL=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Payment providers ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Email (SMTP) ---
# Works with any SMTP provider: SES, Postmark, Mailgun, Zoho, etc.
# Leave SMTP_HOST unset in dev to fall back to logging emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AdStream <no-reply@adstream.example.com>

# --- Logging ---
LOG_LEVEL=info
