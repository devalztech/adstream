# --- API connection ---
# The backend API's base URL (no trailing slash, no /api/v1 suffix —
# the frontend appends that itself). Must be set at BUILD time since
# Next.js inlines NEXT_PUBLIC_* vars into the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- SEO ---
# Used to build absolute URLs in sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://adstream.example.com
